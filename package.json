    "test:windows-parity": "node --experimental-strip-types --test test/filesystem.test.ts test/process.test.ts test/canonical-risk.test.ts",
    "test:stage4": "node --experimental-strip-types --test test/team-coordinator.test.ts test/team-api.test.ts test/team-cancellation.test.ts",
    "test:stage5": "node --experimental-strip-types --test test/procedure-memory.test.ts",
    "test:stage6": "node --experimental-strip-types --test test/world-model.test.ts test/world-publication.test.ts",
    "test:stage7": "node --experimental-strip-types --test test/device-pool.test.ts test/relay-client.test.ts",
