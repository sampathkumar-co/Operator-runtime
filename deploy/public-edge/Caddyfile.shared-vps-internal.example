# Internal-only Caddy for a shared-VPS deployment.
# The public TLS proxy joins operator_ingress at 172.16.3.10 and forwards the
# Operator hostname to 172.16.3.20:8080. Do not publish :8080 on the host.
{
	auto_https off
	servers {
		trusted_proxies static 172.16.3.10/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_body 15s
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

:8080 {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	@public_pages path / /privacy /terms /support
	handle @public_pages {
		reverse_proxy 127.0.0.1:47200 {
			header_up X-Forwarded-Proto https
		}
	}

	@mcp path /mcp
	handle @mcp {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:47200 {
			flush_interval -1
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 2s
			}
		}
	}

	@openai_challenge path /.well-known/openai-apps-challenge
	handle @openai_challenge {
		reverse_proxy 127.0.0.1:47200 {
			header_up X-Forwarded-Proto https
		}
	}

	@oauth path /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server
	handle @oauth {
		reverse_proxy 127.0.0.1:47200 {
			header_up X-Forwarded-Proto https
		}
	}

	@device path /device
	handle @device {
		reverse_proxy 127.0.0.1:8788 {
			stream_timeout 24h
			stream_close_delay 5m
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 2s
			}
		}
	}

	@device_api path /v1/device-result /v1/device-session/rotate /v1/device-enrollment/challenge /v1/device-enrollment/complete /v1/device-enrollment/poll /v1/device-self/reset
	handle @device_api {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8789 {
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 2s
				response_header_timeout 20s
			}
		}
	}

	respond 404
}
